@startuml UC8_PublicationPath_Design
autonumber "<b>0:"
title [UC8] Publication of a Path

actor "Registered User" as RU
participant "Mobile Application" as Client
participant "Inventory Handling" as IH

participant "PathPublication" as PM
participant "BikePath DBMS" as DB

note over RU, Client: Entry Condition: RU presses "Publish"

RU -> Client: clickPublish(recordID)
activate Client

note right of Client: Request preview data
Client -> IH: getPublishPreview\n(recordID)
activate IH

IH -> IH: fetchPathData\n(recordID)
IH --> Client: BikePath
deactivate IH
Client -> Client: renderPreviewData\n(BikePath)

Client -> RU: displayPreview()

alt User presses "Confirm" (Success)
    RU -> Client: pressConfirm()

    
    Client -> PM: publishPath(BikePath)
    activate PM

    PM -> DB: storeNewPath(BikePath)
    activate DB
    DB --> PM: OK
    deactivate DB

    note right of PM: **CRITICAL: Merging Logic**\nAggregates new data into public streets
    
    loop For each Street in BikePath
        PM -> DB: fetchStreetAggregate(Street.coordinates)
        activate DB
        DB --> PM: StreetAggregateData
        deactivate DB
        
        PM -> PM: recalculateStreetStatus(NewData, \nOldAggregate)
        
        PM -> DB: updateStreetStatus(Street.coordinates, \nNewStatus)
        activate DB
        DB --> PM: OK
        deactivate DB
    end loop

    PM --> Client: PublishConfirmation
    deactivate PM
    
    Client --> RU: SuccessMessage\n("Path is now public")
    note over RU, Client: Exit Condition: Publication finalized

else User presses "Back" (Aborted)
    RU -> Client: pressBack()
    
    Client -> Client: returnToPreviousScreen()
    note over RU, Client: Exit Condition: Publication aborted
end

deactivate Client
@enduml