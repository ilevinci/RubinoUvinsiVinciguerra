@startuml UC8_PublicationPath_Design
autonumber "<b>0:"
title [UC8] Publication of a Path

' =======================================================
' COMPONENT DEFINITION
' =======================================================
actor "Registered User" as RU
participant "Mobile Application" as Client
participant "Inventory Handling" as IH

' Backend System
participant "PathPublication" as PM
participant "BikePath DBMS" as DB

' =======================================================
' ENTRY CONDITION
' =======================================================
note over RU, Client: Entry Condition: RU has selected a stored/draft path and presses "Publish"

' =======================================================
' (a) PREVIEW GENERATION
' =======================================================
RU -> Client: clickPublish(BikePath)
activate Client

' Il Client richiede i dati aggiornati per la preview (es. Score attuale)
note right of Client: Request preview data
Client -> IH: getPublishPreview(BikePath)
activate IH

' Recupero dati grezzi
IH -> IH: fetchPathData(BikePath)
' Calcolo preliminare dello score (Preview)
note right of IH: Calculate potential score impact
IH -> IH: calculateProjectedScore(BikePath)

IH --> Client: PreviewData(<streets, status>, score)
deactivate IH
' Visualizzazione
Client --> RU: Preview(<streets, status>, score)

' =======================================================
' EXIT CONDITION: CONFIRM OR BACK
' =======================================================
alt User presses "Confirm" (Success)
    RU -> Client: pressConfirm()

    
    Client -> PM: publishPath(BikePath)
    activate PM

    ' 1. Aggiornamento Visibilità
    PM -> DB: storeNewPath(BikePath)
    activate DB
    DB --> PM: OK
    deactivate DB

    ' 2. ESECUZIONE MERGING LOGIC (Core Business Logic)
    note right of PM: **CRITICAL: Merging Logic**\nAggregates new data into public streets
    
    loop For each Street in BikePath
        PM -> DB: fetchStreetAggregate(Street.coordinates)
        activate DB
        DB --> PM: StreetAggregateData
        deactivate DB
        
        PM -> PM: recalculateStreetStatus(NewData, OldAggregate)
        
        PM -> DB: updateStreetStatus(Street.coordinates, NewStatus)
        activate DB
        DB --> PM: OK
        deactivate DB
    end loop

    ' Risposta Finale
    PM --> Client: PublishConfirmation
    deactivate PM
    
    Client --> RU: SuccessMessage("Path is now public")
    note over RU, Client: Exit Condition: Publication finalized

else User presses "Back" (Aborted)
    RU -> Client: pressBack()
    
    ' Nessuna interazione col server necessaria
    Client -> Client: returnToPreviousScreen()
    note over RU, Client: Exit Condition: Publication aborted
end

deactivate Client
@enduml