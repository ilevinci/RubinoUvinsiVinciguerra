@startuml UC3_TrackAutomatedRide_Final
autonumber "<b>0:"
title [UC3] Track a training session in Automated Mode

actor "Registered User" as RU
participant "Mobile Application" as Client
participant "Automated Path Data Collector" as APDC
participant "Path Data Transformation" as PDTS

participant "MeteoServiceProvider" as Meteo
participant "MapServiceProvider" as Map

' entry condition
note over RU, Client: Entry Condition: RU presses "Track new ride"

RU -> Client: clickTrackNewRide()
activate Client

Client -> APDC: initLocalSession()
note right of APDC: Create temp file on Device Storage

activate APDC
loop Continuous Data Acquisition
    note right of APDC: Internal Sensor Access
    APDC -> APDC: acquireSensors(GPS, Gyro, Accel)
    APDC -> APDC: appendToLocalFile(DataChunk)
end

alt User manually stops
    RU -> Client: pressStop()
    Client -> APDC: stopAcquisition()
else System detects inactivity
    APDC -> APDC: analyzeMovementPatterns()
    note right of APDC: No movement detected for threshold time
    APDC -> APDC: triggerAutoStop()
    APDC -> Client: notifyAutoStop()
    Client -> RU: autoStopNotification()
end


' Chiamate dirette dal Client ai Servizi Esterni
par Parallel External Requests
    ' Meteo
    APDC -> Meteo: fetchWeather(GPS, Time)
    activate Meteo
    Meteo --> APDC: Weather
    deactivate Meteo
    
    ' Map Matching
    APDC -> Map: requestMapMatching(GPS)
    activate Map
    Map --> APDC: RefinedPath
    deactivate Map

    ' Path Status and Obstacles
    APDC -> PDTS: computeStatusAndObstacles(GPS, Gyro, Accel)
    activate PDTS
    PDTS --> APDC: Status, Obstacles
    deactivate PDTS
end par

' Generazione Preview Locale
APDC -> Client: generateTripPreview(RefinedPath, Weather, Status, Obstacles)
deactivate APDC
Client --> RU: RefinedTripPreview

RU -> Client: checkAndCorrectData()
Client -> Client: updateData()

alt RU presses "Save"
    RU -> Client: pressSave()
    
    Client -> Client: storeDataInLocalFile()
    Client --> RU: SuccessMessage

else RU presses "Discard"
    RU -> Client: pressDiscard()
    Client -> Client: deleteLocalFile()
    Client --> RU: DiscardMessage
end

deactivate Client
@enduml