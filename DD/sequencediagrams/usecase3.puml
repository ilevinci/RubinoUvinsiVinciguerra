@startuml UC3_TrackAutomatedRide_Final
autonumber "<b>0:"
title [UC3] Track a training session in Automated Mode

' =======================================================
' COMPONENT DEFINITION
' =======================================================
actor "Registered User" as RU
participant "Mobile Application\n(Tier 1)" as Client

' Servizi Esterni (Chiamati direttamente dal Client)
participant "MeteoServiceProvider" as Meteo
participant "MapServiceProvider" as Map

' Backend System
participant "BBP API Gateway\n(Tier 2)" as GW
box "BBP Application Server (Tier 3)" #LightBlue
    participant "PathManager" as TM
end box
participant "BBP BikePath DB\n(Tier 4)" as DB

' =======================================================
' ENTRY CONDITION
' =======================================================
note over RU, Client: Entry Condition: RU presses "Track new ride"

' =======================================================
' (a) START TRACKING
' =======================================================
RU -> Client: clickTrackNewRide()
activate Client

Client -> Client: initLocalSession()
note right of Client: Create temp file on Device Storage

' =======================================================
' (b), (c) LOCAL ACQUISITION LOOP
' =======================================================
loop Continuous Data Acquisition
    note right of Client: Internal Sensor Access
    Client -> Client: acquireSensors(GPS, Gyro, Accel)
    Client -> Client: appendToLocalFile(DataChunk)
end

' =======================================================
' (d) DETECT END OF ACTIVITY
' =======================================================
alt User manually stops
    RU -> Client: pressStop()
else System detects inactivity
    Client -> Client: analyzeMovementPatterns()
    note right of Client: No movement detected for threshold time
    Client -> Client: triggerAutoStop()
    Client --> RU: notifyAutoStop()
end

' =======================================================
' EXTERNAL REFINEMENT (Smart Client)
' =======================================================
'note right of Client: Client acts as Orchestrator

' Chiamate dirette dal Client ai Servizi Esterni
par Parallel External Requests
    ' Meteo
    Client -> Meteo: fetchWeather(GPS, Timestamp)
    activate Meteo
    Meteo --> Client: WeatherData
    deactivate Meteo
    
    ' Map Matching
    Client -> Map: requestMapMatching(RawGPSPoints)
    activate Map
    Map --> Client: RefinedPathGeometry
    deactivate Map
end par

' Generazione Preview Locale
Client -> Client: generateTripPreview(RefinedPath, Weather)
Client --> RU: displayPreview()

' (f) USER VALIDATION
RU -> Client: checkAndCorrectData()

' =======================================================
' EXIT CONDITION: SAVE OR DISCARD
' =======================================================
alt RU presses "Save" (Sync to Backend)
    RU -> Client: pressSave()
    
    ' Invio del pacchetto completo e pulito al server
    note right of Client: Uploading VALIDATED data via HTTPS
    Client -> GW: POST /api/paths (PathDTO)
    activate GW
    
    note right of GW: Routing to PathManager
    GW -> TM: saveNewPath(PathDTO)
    deactivate GW
    activate TM

    ' Persistenza
    TM -> DB: createPath(PathEntity)
    activate DB
    DB --> TM: confirmation
    deactivate DB

    ' Logica di Fusione (Requisito Gruppo 3)
    note right of TM: Trigger Async Merging Logic
    TM -> TM: updateStreetStatus(PathDTO)

    ' Risposta
    TM --> GW: 201 Created
    deactivate TM
    activate GW
    GW --> Client: 201 Created
    deactivate GW
    
    Client -> Client: deleteLocalFile()
    Client --> RU: showSuccessMessage()

else RU presses "Discard"
    RU -> Client: pressDiscard()
    Client -> Client: deleteLocalFile()
    Client --> RU: showDiscardMessage()
end

deactivate Client
@enduml