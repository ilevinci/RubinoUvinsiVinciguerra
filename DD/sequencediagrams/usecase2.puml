@startuml UC2_UserLogin_Design
autonumber "<b>0:"
title [UC2] User Login 

actor "Registered User" as RU
participant "Mobile Application" as Client
participant "UserManagement" as Auth
participant "UserDBMS" as DB

'entry condition
note over RU, Client: Entry Condition: RU opens the BBP platform

RU -> Client: clickSignIn()
activate Client

Client --> RU: displayLoginForm()

' Steps (a) and (b): Insertion of credentials
RU -> Client: insertCredentials(nickname/email, password)

Client -> Auth: authenticateUser(LoginDTO)
activate Auth

' Step (c): Verification
' Il sistema verifica i dati interrogando il DB
note right of Auth: System checks if data is correct
Auth -> DB: findUserByCredentials(email, nickname)
activate DB
DB --> Auth: userEntity / null
deactivate DB

' Logic: Alternative paths
alt Data is not correct (Exception)
    ' Return 401 Unauthorized
    Auth --> Client: unauthorizedUser()
    Client --> RU: showError("Invalid credentials")

else Data is correct (Success)
    ' Logica interna di autenticazione (Hash check & Token generation)
    note right of Auth: Password Hash Check & Token Generation
    
    ' Aggiornamento stato (opzionale ma raccomandato)
    Auth -> DB: updateLastLogin(userID)
    activate DB
    DB --> Auth: ok
    deactivate DB

    ' Risposta con Token di sessione
    Auth --> Client: createToken(AuthToken)
    deactivate Auth
    
    ' Gestione lato client
    Client -> Client: storeTokenLocally()
    Client --> RU: loginSuccessful()
    deactivate Client
end

'exit condition
note over RU, Client: Exit Condition: User successfully logged in

@enduml