@startuml UC4_InsertManualMode_Design
autonumber "<b>0:"
title [UC4] Insert data of the bike path in Manual Mode

actor "Registered User" as RU
participant "Mobile Application" as Client
participant "Manual Path Insertion Module" as MPIM

participant "MapServiceProvider" as Map

note over RU, Client: Entry Condition: RU presses "Insert new ride"

RU -> Client: clickInsertNewRide()
activate Client
Client -> MPIM: initManualSession()
activate MPIM
MPIM --> Client: ok
Client-> RU: displayManualInputForm()

loop For each street inserted by RU
    RU -> Client: insertStreetDetails(name, city, status, segment, obstacle, obstacleCoordinates)
    Client -> MPIM: forwardStreetDetails(name, city, status, segment, obstacle, obstacleCoordinates)

    note right of MPIM: Validate existence via Map Service
    MPIM -> Map: validateStreetSegment(name, city, segment)
    activate Map
    Map --> MPIM: Coordinates, Tiles / null
    deactivate Map
    
    alt Segment Valid
        note right of MPIM: Check continuity with previous segment
        MPIM -> MPIM: checkPathContinuity()
        
        MPIM -> MPIM: storeTempSegment(Street)
        MPIM --> Client: SegmentAddedConfirmation
        Client --> RU: SegmentAddedConfirmation
    else Segment Invalid
        MPIM --> Client: ErrorMessage("Invalid Segment")
        Client --> RU: ErrorMessage("Invalid Segment")
    end
end

RU -> Client: pressConfirm()
Client -> MPIM: requestPathPreview()
MPIM -> MPIM: prepareFinalPathPreview()
MPIM --> Client: PathPreviewData
deactivate MPIM
Client --> RU: PathPreviewData

alt RU presses "Save" (Sync to Backend)
    RU -> Client: pressSave()
    
    Client -> Client: storeDataInLocalFile()
    Client --> RU: SuccessMessage

else RU presses "Discard"
    RU -> Client: pressDiscard()
    Client -> Client: deleteLocalFile()
    Client --> RU: DiscardMessage
end

deactivate Client
@enduml