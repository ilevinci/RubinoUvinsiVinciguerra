@startuml UC4_InsertManualMode_Design
autonumber "<b>0:"
title [UC4] Insert data of the bike path in Manual Mode

' =======================================================
' COMPONENT DEFINITION
' =======================================================
actor "Registered User" as RU
participant "Mobile Application" as Client
participant "Manual Path Insertion Module" as MPIM

' External Service (Validazione Geografica)
participant "MapServiceProvider" as Map

' =======================================================
' ENTRY CONDITION
' =======================================================
note over RU, Client: Entry Condition: RU presses "Insert new ride"

' =======================================================
' INITIALIZATION
' =======================================================
RU -> Client: clickInsertNewRide()
activate Client
Client -> MPIM: initManualSession()
activate MPIM
MPIM --> Client: readyForInput()
Client--> RU: displayManualInputForm()

' =======================================================
' (a) & (b) ITERATIVE INSERTION & VALIDATION
' =======================================================
loop For each street inserted by RU
    RU -> MPIM: insertStreetDetails(name, city, status)
    
    ' Validazione Esterna (Smart Client)
    note right of MPIM: Validate existence via Map Service
    MPIM -> Map: validateStreetSegment(name, city)
    activate Map
    Map --> MPIM: ValidationResult (Coords, Geometry)
    deactivate Map
    
    alt Segment Valid
        ' Validazione Logica Locale
        note right of MPIM: Check continuity with previous segment
        MPIM -> MPIM: checkPathContinuity()
        
        MPIM -> MPIM: storeTempSegment(SegmentData)
        MPIM --> RU: showSegmentAdded()
    else Segment Invalid
        MPIM --> RU: showError("Street not found or invalid")
    end
end

' =======================================================
' (c) PREVIEW
' =======================================================
note right of Client: Assemble all segments
MPIM -> Client: prepareFinalPathPreview()
deactivate MPIM
Client --> RU: displayPreview(Path_Data)

' =======================================================
' EXIT CONDITION: SAVE OR DISCARD
' =======================================================
alt RU presses "Save" (Sync to Backend)
    RU -> Client: pressSave()
    
    Client -> Client: storeDataInLocalFile()
    Client --> RU: showSuccessMessage()

else RU presses "Discard"
    RU -> Client: pressDiscard()
    Client -> Client: deleteLocalFile()
    Client --> RU: showDiscardMessage()
end

deactivate Client
@enduml